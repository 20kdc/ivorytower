#!/bin/sh -e
../../setup --install --all=on
echo "(passed install)"

rm -rf build
mkdir -p build

do_variant() {
	variant="$1"
	shift
	meson setup "build/${variant}" --cross-file "ivt/${variant}" $@ > "build/${variant}_setup.log" || (echo "error in setup ${variant}" ; exit 1)
	meson compile -C "build/${variant}"
}

do_stlp() {
	prefix="$1"
	shift
	suffix="$1"
	shift
	do_variant "${prefix}default${suffix}" $@
	do_variant "${prefix}static${suffix}" $@
	do_variant "${prefix}zero${suffix}" $@
}

# Test most things reasonably available to Ubuntu 24.04.
# (We can't pull in MinGW aarch64 Windows.)

if [ "$#" != 0 ]; then
	do_variant "$1"
	exit
fi

# 'important' ('this will break and it is important if it breaks') cases

do_stlp lgx32_ _scout

# w32cross can only do default STL disposition.
# This is because it relies *heavily* on dynamic linking to do all its work from more reasonably licensed resources.
do_variant wx32_default_w32cross
do_variant wx64_default_w32cross
do_variant wa64_default_w32cross

do_stlp lgx64_ _scout
do_stlp lgx64_ _sniper

do_stlp wx32_ _mingw
do_stlp wx64_ _mingw

do_stlp mx64_ ""
do_stlp ma64_ ""
