#!/bin/sh -e
../setup --install all=on
echo "(passed install)"

rm -rf build
mkdir -p build

do_variant() {
	meson setup "build/$1" --cross-file "ivt/$1" > "build/$1_setup.log" || (echo "error in setup $1" ; exit 1)
	meson compile -C "build/$1"
}

do_stlp() {
	do_variant "$1default$2"
	do_variant "$1static$2"
	do_variant "$1zero$2"
}

# Test most things reasonably available to Ubuntu 24.04.
# (We can't pull in aarch64 Windows.)

do_stlp lgx32_ _scout
do_stlp lgx64_ _scout

do_stlp lgx64_ _sniper

do_stlp wx32_ _mingw
do_stlp wx64_ _mingw

do_stlp wx32_ _w32cross
do_stlp wx64_ _w32cross
do_stlp wa64_ _w32cross

do_stlp mx64_ ""
do_stlp ma64_ ""
