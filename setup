#!/bin/sh -e

ITSETUP_WHERE="`readlink -e "$0"`"
export ITSETUP_DIR="`dirname $ITSETUP_WHERE`"

setupcore_build() {
	meson setup "$ITSETUP_DIR/build" "$ITSETUP_DIR"
	meson compile -C "$ITSETUP_DIR/build"
}

setupcore_build > "$ITSETUP_DIR/setupcore_build.log" || (echo "Error during ivorytower setup:" ; cat "$ITSETUP_DIR/setupcore_build.log" ; exit 1)

exec "$ITSETUP_DIR/build/setupcore" "$@"
