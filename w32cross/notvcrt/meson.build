# Meson build file for notvcrt.
# This lets notvcrt be cleanly built using the bootstrap compilation environment.

project('notvcrt', 'c', 'cpp')

notvcrt_lib = static_library('notvcrt',
	'src/crt0_common.c',
	'src/crt0_dll.c',
	'src/crt0_dll_nomain.c',
	'src/crt0_exe_con.c',
	'src/crt0_exe_gui.c',
	'src/crt0_exe_con_w.c',
	'src/crt0_exe_gui_w.c',
	'src/crt0_fltused.c',
	'src/crt0_gs.c',
	'src/vcr_del01.cpp',
	'src/vcr_del02.cpp',
	'src/vcr_del03.cpp',
	'src/vcr_del04.cpp',
	'src/vcr_del05.cpp',
	'src/vcr_del06.cpp',
	'src/vcr_del07.cpp',
	'src/vcr_del08.cpp',
	'src/vcr_del09.cpp',
	'src/vcr_del10.cpp',
	'src/vcr_del11.cpp',
	'src/vcr_del12.cpp',
	'src/vcr_new1.cpp',
	'src/vcr_new2.cpp',
	'src/vcr_new3.cpp',
	'src/vcr_new4.cpp',
	'src/vcr_new5.cpp',
	'src/vcr_new6.cpp',
	'src/vcr_new7.cpp',
	'src/vcr_new8.cpp',
	'src/vcr_new_nothrow.cpp',
	'src/vcr_typeinfo.cpp'
)
