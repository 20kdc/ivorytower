; We don't actually have much to run through this right now.
; We might later, but not now.
; The singular symbol alias is a known-documented example that also works to ensure the file is valid.
LIBRARY "api-ms-win-crt-stdio-l1-1-0.dll"
EXPORTS
	open==_open
	close==_close
	lseek==_lseek
	read==_read
	write==_write
	fileno==_fileno
	setmode==_setmode

LIBRARY "api-ms-win-crt-environment-l1-1-0.dll"
EXPORTS
	putenv==_putenv
