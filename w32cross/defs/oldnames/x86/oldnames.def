; We don't actually have much to run through this right now.
; We might later, but not now.
; The singular symbol alias is a known-documented example that also works to ensure the file is valid.
LIBRARY "api-ms-win-crt-stdio-l1-1-0.dll"
EXPORTS
	open==_open
	close==_close
	lseek==_lseek
	read==_read
	write==_write
	fileno==_fileno
	setmode==_setmode

LIBRARY "api-ms-win-crt-environment-l1-1-0.dll"
EXPORTS
	putenv==_putenv

LIBRARY "api-ms-win-crt-filesystem-l1-1-0.dll"
EXPORTS
	unlink==_unlink
	wunlink==_wunlink

LIBRARY "api-ms-win-crt-convert-l1-1-0.dll"
EXPORTS
	; SDL2 needs this, funnily enough
	itoa==_itoa
