# see 01init.ninja

rule aexe
  command = "${clang}-${vcarch}" -g -Wl,/demangle:no $in -o $out

rule wexe
  command = "${clang}-${vcarch}" -g -Wl,/demangle:no -D_UNICODE $in -o $out

rule dll
  command = "${clang}-${vcarch}" -g -Wl,/demangle:no -shared $in -o ${out1}

rule rtdll
  command = "${clang}-${vcarch}" -g -Wl,/demangle:no -shared $in -o $out
