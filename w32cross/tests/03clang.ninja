# see 01init.ninja

clangcomopts = -g -gcodeview -Wl,/demangle:no

rule aexe
  command = "${clang}-${vcarch}" $clangcomopts $in -o $out

rule wexe
  command = "${clang}-${vcarch}" $clangcomopts -D_UNICODE $in -o $out

rule dll
  command = "${clang}-${vcarch}" $clangcomopts -shared $in -o ${out1}

rule rtdll
  command = "${clang}-${vcarch}" $clangcomopts -shared $in -o $out

rule rtdll_asm
  command = "${clang}-${vcarch}" -S -shared $in -o $out
