# see 01init.ninja

rule aexe
  command = "${cl}-${vcarch}" /Zi /EHs /clang:-Wl,/demangle:no $in -o $out

rule wexe
  command = "${cl}-${vcarch}" /Zi /EHs /clang:-Wl,/demangle:no /D_UNICODE $in -o $out

rule dll
  command = "${cl}-${vcarch}" /Zi /EHs /clang:-Wl,/demangle:no /LD $in -o ${out1}

rule rtdll
  command = "${cl}-${vcarch}" /Zi /EHs /clang:-Wl,/demangle:no /LD $in -o $out
