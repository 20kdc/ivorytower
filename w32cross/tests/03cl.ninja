# see 01init.ninja

clcomopts = /Zi /EHs /clang:-Wl,/demangle:no

rule aexe
  command = "${cl}-${vcarch}" $clcomopts $in -o $out

rule wexe
  command = "${cl}-${vcarch}" $clcomopts /D_UNICODE $in -o $out

rule dll
  command = "${cl}-${vcarch}" $clcomopts /LD $in -o ${out1}

rule rtdll
  command = "${cl}-${vcarch}" $clcomopts /LD $in -o $out
