# see 01init.ninja
chain=${chain}
vcarch=${vcarch}

include tests/03${chain}.ninja

bin=tests/bin/${chain}_${vcarch}

# crt0 test

build ${bin}/a_smoke_a.exe: aexe tests/a_smoke.cpp ${bin}/cxxdll.lib
build ${bin}/a_smoke_w.exe: wexe tests/a_smoke.cpp ${bin}/cxxdll.lib

build ${bin}/cxxdll.dll ${bin}/cxxdll.lib: dll tests/c_cxxdll.cpp
  out1 = ${bin}/cxxdll.dll

# b_launch modular test system

build ${bin}/b_launch.exe: aexe tests/b_launch.cpp

build ${bin}/mod_exceptions_vs_destructors.dll: rtdll tests/mods/exceptions_vs_destructors.cpp
build ${bin}/mod_cout.dll: rtdll tests/mods/cout.cpp
build ${bin}/mod_builtins.dll: rtdll tests/mods/builtins.cpp

# other

build ${bin}/b_cppcrt.exe: aexe tests/b_cppcrt.cpp

build ${bin}/d_micro_fbxcommon.dll ${bin}/d_micro_fbxcommon.lib: dll tests/d_micro_fbxcommon.cpp
  out1 = ${bin}/d_micro_fbxcommon.dll

build ${bin}/z_endlesschamber.dll ${bin}/z_endlesschamber.lib: dll tests/z_endlesschamber.cpp
  out1 = ${bin}/z_endlesschamber.dll
